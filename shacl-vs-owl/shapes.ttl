@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.org/> .

ex:DatasetShape
    a sh:NodeShape ;
    sh:targetClass ex:Dataset ;
    sh:property [
        sh:path ex:hasOwner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A dataset needs exactly one owner." ;
    ] .
